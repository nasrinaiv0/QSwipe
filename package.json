{
  "name": "qswipe",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "QSwipe — attendance, commitments, team hierarchy and QR team onboarding. Local-first TypeScript web app.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "rooms:staging": "node lib/rooms/http.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && node --test \"test/*.test.js\"",
    "check": "npm run typecheck && npm run test && npm run build"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "jsqr": "1.4.0",
    "uqr": "0.1.3"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
